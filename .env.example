# ===== 服务 =====
APP_HOST=127.0.0.1
APP_PORT=8000
SCHEDULER_ENABLED=true

# ===== MySQL =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=scraper

# ===== 通知渠道（敏感信息只放这里，接口返回脱敏值） =====
NOTIFY_ENABLED=true
# 钉钉机器人：webhook 完整地址，secret 为“加签”密钥（可留空）
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
# 企业微信群机器人 webhook
WECOM_WEBHOOK=

# ===== 浏览器（可选） =====
# 虚拟机等环境指定 Chrome 路径，例如 /usr/bin/google-chrome；留空用本机 Chrome
PZDS_CHROME=
